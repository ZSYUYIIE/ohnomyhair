extends SceneTree
## Writes docs/levels/gate_graph.md: every chapter's rooms as a Mermaid graph
## (room -> gate -> the verbs that pass it), plus a table of which haircut pairs each
## room allows. Generated from the built scenes (Room.styles / Room.gates), so rerun it
## after rebuilding a level. The same data drives tests/test_gates.gd.
## Run: godot --headless --path . --script res://tools/gate_graph.gd

const OUT := "res://docs/levels/gate_graph.md"
const LAB := {"path": "res://scenes/levels/style_lab.tscn", "title": "Style Lab"}


func _initialize() -> void:
	var md := PackedStringArray()
	md.append("# Gate graph (generated)\n")
	md.append("> Generated by `tools/gate_graph.gd` from the built level scenes: don't edit by hand.")
	md.append("> Each room lists its obstacles (gates) and the verbs that get past each one; every")
	md.append("> haircut pair the room allows must have a verb for every gate (`tests/test_gates.gd`).")
	md.append("> Rules and verbs: `scenes/systems/style_rules.gd`; design: `docs/design/roster_and_chapters.md`.\n")
	var chapters: Array = Progress.LEVELS.duplicate()
	chapters.append(LAB)
	for i in chapters.size():
		_chapter(md, chapters[i], i)
	md.append("## Verbs\n")
	md.append("| Verb | Meaning | Who |")
	md.append("|---|---|---|")
	for verb in StyleRules.VERB_INFO:
		md.append("| `%s` | %s | %s |" % [verb, StyleRules.VERB_INFO[verb], _who(verb)])
	var file := FileAccess.open(OUT, FileAccess.WRITE)
	file.store_string("\n".join(md) + "\n")
	file.close()
	print(OUT, " written")
	quit()


func _chapter(md: PackedStringArray, entry: Dictionary, index: int) -> void:
	var level: Level = load(entry.path).instantiate()
	var heading := "Style Lab" if entry == LAB else "Chapter %d: %s" % [index + 1, entry.title]
	md.append("## %s\n" % heading)
	md.append("| Room | Starts as (P1 / P2) | Chair offers | Pairs checked |")
	md.append("|---|---|---|---|")
	var rooms: Array = level.get_node("Rooms").get_children()
	for room: Room in rooms:
		md.append("| %s | %s | %s | %d |" % [room.title, " / ".join(_names(room.starting_hair)),
			", ".join(_names(room.styles)), StyleRules.pairs(room.styles).size()])
	md.append("\n```mermaid\nflowchart LR")
	for r in rooms.size():
		var room: Room = rooms[r]
		md.append("  R%d[\"%s\"]" % [r, room.title.replace("\"", "'")])
		if r > 0:
			md.append("  R%d --> R%d" % [r - 1, r])
		for g in room.gates.size():
			var gate: Dictionary = room.gates[g]
			md.append("  R%d --- G%d_%d{{\"%s\"}}" % [r, r, g, gate.name.replace("\"", "'")])
			md.append("  G%d_%d -.- V%d_%d([\"%s\"])" % [r, g, r, g, " / ".join(gate.any)])
	md.append("```\n")
	level.free()


func _names(hairs: PackedInt32Array) -> PackedStringArray:
	var out := PackedStringArray()
	for h in hairs:
		out.append(StyleRules.hair_name(h))
	return out


func _who(verb: String) -> String:
	if verb in StyleRules.UNIVERSAL:
		return "anyone"
	for hair in StyleRules.SOLO:
		if verb in StyleRules.SOLO[hair]:
			return StyleRules.hair_name(hair)
	for combo in StyleRules.COMBOS:
		if combo.verb == verb:
			return " + ".join(_names(PackedInt32Array(combo.needs)))
	return ""
